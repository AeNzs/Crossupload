APP_URL=http://localhost:3100
# Alamat bind server. Default 127.0.0.1 (hanya mesin sendiri).
# Isi 0.0.0.0 hanya bila sengaja diekspos di belakang reverse proxy + firewall.
BIND_ADDR=127.0.0.1
ALLOWED_EMAIL=owner@local
APP_PASSWORD=
# 32 byte hex acak (64 karakter hex)
AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=

# Privasi default sebelum aplikasi lolos App Review di portal developer
YOUTUBE_PRIVACY=private
TIKTOK_PRIVACY=SELF_ONLY

# Opsional untuk halaman legal (/terms, /privacy, /data-deletion) dan verifikasi TikTok:
CONTACT_EMAIL=
TIKTOK_SITE_VERIFICATION=

# Opsional: FFMPEG_PATH, FFPROBE_PATH, DATA_DIR, DATABASE_URL
# Opsional fallback kredensial via env (disarankan isi langsung lewat ikon kunci di UI):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
